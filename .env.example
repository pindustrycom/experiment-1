# Copy to .env and fill in. Never commit .env. Every value here is read only by the server.

# ---- Mode -------------------------------------------------------------------------------------
# demo: simulated, clearly labelled data; no API keys needed.
# production: real providers only. The worker refuses to start if demo rows are in the database.
APP_MODE=demo

# ---- Public address (Caddy) ---------------------------------------------------------------------
# Your domain for automatic HTTPS (DNS A record must point at this server), or "localhost" to test.
SITE_ADDRESS=monitor.example.com
# Contact e-mail for Let's Encrypt expiry notices.
ACME_EMAIL=you@example.com

# ---- Database (internal only; never published) -----------------------------------------------------
POSTGRES_USER=sm
POSTGRES_DB=splittability
# Generate: openssl rand -hex 24
POSTGRES_PASSWORD=

# ---- Auth ---------------------------------------------------------------------------------------
# Generate: openssl rand -hex 32   (at least 32 characters; changing it signs everyone out)
SECRET_KEY=
COOKIE_SECURE=true
SESSION_TTL_HOURS=12
# First admin, created on start if it does not exist. Remove the password after first login,
# or create admins with: docker compose run --rm migrate python -m app.cli create-admin --email you@example.com
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# ---- Claude (news interpretation) -----------------------------------------------------------------
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-haiku-5-5
CLAUDE_EFFORT=medium

# ---- Data providers (all optional; missing ones make components "unavailable", never zero) --------
# Tiingo: dividend-adjusted (total-return) daily prices. Recommended.
TIINGO_API_KEY=
# Stooq: free daily prices (no key), split-adjusted; flagged as price-return. Used as fallback.
ENABLE_STOOQ=true
# Finnhub company news.
FINNHUB_API_KEY=
# Alpha Vantage news sentiment feed (small free quota).
ALPHAVANTAGE_API_KEY=
# SEC EDGAR filings and XBRL fundamentals: required descriptive User-Agent with a contact e-mail.
SEC_USER_AGENT=SplittabilityMonitor research you@example.com

# ---- Operations ---------------------------------------------------------------------------------
LOG_LEVEL=INFO
BACKUP_RETENTION_DAYS=14
